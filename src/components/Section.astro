---
interface Props {
  title: string;
  /** Right-aligned mono note beside the heading. */
  meta?: string;
  id?: string;
}
const { title, meta, id } = Astro.props;
---
<section class="section" id={id}><div class="wrap">
<div class="section-head"><h2>{title}</h2>{meta && <span class="meta">{meta}</span>}</div>
<slot />
</div></section>
