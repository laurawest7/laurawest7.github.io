---
interface Props {
  /** Project pages mark Work as the current section, the About page marks About; the home page marks neither. */
  current?: "work" | "about";
}
const { current } = Astro.props;
---
<header class="topbar"><div class="wrap">
<a class="wordmark" href="/">Laura West</a>
<nav class="topnav" aria-label="Main">
<a href="/#work" aria-current={current === "work" ? "page" : undefined}>Work</a>
<a href="/#capabilities">Capabilities</a>
<a href="/about/" aria-current={current === "about" ? "page" : undefined}>About</a>
</nav></div></header>
