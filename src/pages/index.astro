---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import TitleBlock from "../components/TitleBlock.astro";
import WorkCard from "../components/WorkCard.astro";
import { projects } from "../data/projects";

/** Add a project slug to an item to link it to that project page. */
const caps: { heading: string; items: { slug?: string; text: string }[] }[] = [
  {
    heading: "Materials and construction",
    items: [
      { text: "Material development" },
      { text: "Prototyping" },
      { text: "Patterning" },
      { text: "Industrial sewing" },
      { text: "Bonding" },
      { text: "Soft and hard molding" },
    ],
  },
  {
    heading: "Documentation and manufacturing",
    items: [
      { text: "Tech packs" },
      { text: "Design for manufacturing" },
      { text: "Supplier development" },
      { text: "Supplier communication" },
      { text: "Sourcing" },
      { text: "Vendor qualification" },
    ],
  },
  {
    heading: "Validation and QA",
    items: [
      { text: "Material testing" },
      { text: "Product testing" },
      { text: "Quality improvement" },
      { text: "CTQ documentation" },
    ],
  },
];
---
<BaseLayout title="Laura West · Product developer">
<section class="mat"><div class="ruler"></div>
<div class="wrap hero"><div class="hero-grid">
<div>
<p class="eyebrow">Product developer</p>
<h1>Laura West</h1>
<p class="lede">Technical soft goods innovation and development.</p>
<p>I operate at the intersection of textiles, soft composites, hard goods and electronics. I make ideas real through rapid iteration and hands on prototyping, translating design intent into validated product.</p>
</div>
<TitleBlock rows={[
  ["Now", "Verve Motion, Product Development Manager"],
  ["Before", "Thule, Product Developer; Trusst Lingerie, Founder and Chief Product Officer"],
  ["Education", "Carnegie Mellon, Industrial Design"],
]} />
</div></div></section>

<Section id="work" title="Selected Work" meta={`${projects.length} projects`}>
<div class="work">
{projects.map((p) => <WorkCard project={p} />)}
</div>
</Section>

<Section id="capabilities" title="Capabilities">
<div class="caps">
{caps.map((group) => (
  <div class="cap"><h3>{group.heading}</h3><ul>
  {group.items.map((item) => <li>{item.slug ? <a href={`/${item.slug}/`}>{item.text}</a> : item.text}</li>)}
  </ul></div>
))}
</div>
</Section>
</BaseLayout>
