---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectHeader from "../components/ProjectHeader.astro";
import NextProject from "../components/NextProject.astro";
import Section from "../components/Section.astro";
import Figure from "../components/Figure.astro";
import { bySlug } from "../data/projects";

const project = bySlug("thule-approach");
---
<BaseLayout title={project.pageTitle} current="work">
<ProjectHeader project={project} />

<Section title="The Tent">
<div class="row">
<Figure
  src="/img/approach-deployed.jpg"
  alt="Thule Approach deployed on an SUV with its ladder"
  width={1164} height={1200} maxWidth="520px"
  caption="Deployed, with ladder."
/>
<div class="figs" style="margin-top:0">
<Figure src="/img/approach-interior.jpg" alt="Two people inside the tent looking out over mountains" width={1200} height={1200} maxWidth="420px" />
<Figure
  src="/img/approach-closed.jpg"
  alt="Thule Approach closed on the roof of an SUV"
  width={1200} height={1200} maxWidth="300px"
  caption="Closed for driving."
/>
</div></div>
</Section>

<Section title="Construction Details">
<div class="figs two">
<Figure
  src="/img/approach-zipper-gimp.jpg"
  alt="Tent fabric attached to the base with a zipper gimp in an aluminum channel"
  width={1600} height={1100}
>
  <Fragment slot="caption"><b>Zipper gimp.</b> The top fabric removes for spot cleaning. It attaches to the base with a zipper gimp: a flexible tube encased in fabric that slides along an extruded aluminum and plastic channel.</Fragment>
</Figure>
<Figure
  src="/img/approach-seam.jpg"
  alt="Close-up of a flat felled, seam-taped corner on the tent fabric"
  width={1205} height={1600} maxWidth="380px"
>
  <Fragment slot="caption"><b>Seams.</b> For durability, every seam is flat felled and then seam taped for extra water resistance.</Fragment>
</Figure>
</div>
</Section>

<NextProject slot="next" from={project.slug} />
</BaseLayout>
