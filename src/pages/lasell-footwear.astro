---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectHeader from "../components/ProjectHeader.astro";
import NextProject from "../components/NextProject.astro";
import Section from "../components/Section.astro";
import Figure from "../components/Figure.astro";
import Stats from "../components/Stats.astro";
import { bySlug } from "../data/projects";

const project = bySlug("lasell-footwear");
---
<BaseLayout title={project.pageTitle} current="work">
<ProjectHeader project={project} />

<Section title="Marketing brief">
<Stats items={[
  { v: "$70", k: "Retail price" },
  { v: "$14", k: "Target FOB" },
  { v: "25,000", k: "Unit forecast" },
  { v: "5–11W", k: "Size range" },
]} />
<div class="row" style="margin-top:2.5rem">
<div class="prose"><p>A women's running shoe for beginner runners aged 20 to 35 who are value focused. The hero features are a molded heel and "techy" overlays.</p>
<p>The main challenge was hitting the target FOB at an entry price point. The costed build came in at $15.00 against a $14 target.</p>
<div class="table-wrap"><table class="spec">
<caption>FOB breakdown</caption>
<thead><tr><th>Line</th><th class="num">% of FOB</th><th class="num">Value</th><th>Note</th></tr></thead>
<tbody>
<tr><td>Upper</td><td class="num">38%</td><td class="num">$5.70</td><td></td></tr>
<tr><td>Midsole / outsole</td><td class="num">29%</td><td class="num">$4.35</td><td></td></tr>
<tr><td>Tooling</td><td class="num">0%</td><td class="num">–</td><td>Amortized on last season's shoe</td></tr>
<tr><td>Packaging</td><td class="num">6%</td><td class="num">$0.90</td><td></td></tr>
<tr><td>Labor</td><td class="num">27%</td><td class="num">$4.05</td><td></td></tr>
<tr class="pick"><td><b>Total</b></td><td class="num"></td><td class="num"><b>$15.00</b></td><td>Target $14</td></tr>
</tbody></table></div></div>
<Figure
  src="/img/lasell-brief.jpg"
  alt="Marketing brief page of the reverse tech pack"
  width={1370} height={1035} pad
  caption="Marketing brief page."
/>
</div>
</Section>

<Section title="Materials and construction">
<Figure
  src="/img/lasell-construction.jpg"
  alt="Lateral view of the shoe with construction callouts"
  width={1370} height={870} pad
  caption="Callouts cover the molded 1 mm TPU vamp overlay, the compression-molded heel overlay over 5 mm EVA, the debossed logo on the U-throat and the 2 mm perimeters on overlays."
/>
</Section>

<Section title="Views and pattern">
<Figure
  src="/img/lasell-views.jpg"
  alt="Top, lateral, medial, heel and bottom views of the shoe"
  width={1260} height={943} pad
  caption="Top, lateral, medial, heel and bottom views."
/>
<div class="figs two">
<Figure
  src="/img/lasell-pattern.jpg"
  alt="Flattened shell pattern of the upper with tongue and heel overlay"
  width={1118} height={845} pad
  caption="Shell pattern: medial and lateral sides, tongue and heel overlay."
/>
<Figure
  src="/img/lasell-reinforcement.jpg"
  alt="Reinforcement and inner construction drawing"
  width={1263} height={845} pad
  caption="Reinforcements: collar foam, heel counter, toe and medial reinforcement."
/>
</div>
</Section>

<NextProject slot="next" from={project.slug} />
</BaseLayout>
