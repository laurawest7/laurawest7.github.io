---
import TopBar from "../components/TopBar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE_DESCRIPTION } from "../data/projects";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Passed through to the top bar to mark the current section. */
  current?: "work" | "about";
}
const { title, description = SITE_DESCRIPTION, current } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:ital,wght@0,400;0,600;1,400&display=swap" />
</head>
<body>
<TopBar current={current} />
<main><slot /></main>
<slot name="next" />
<SiteFooter />
</body>
</html>
